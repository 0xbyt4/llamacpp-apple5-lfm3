+typedef decltype(kernel_compat_norm_fuse_impl<1>) kernel_compat_norm_fuse_t;
+
+template [[host_name("kernel_compat_norm_f32")]]         kernel kernel_compat_norm_fuse_t kernel_compat_norm_fuse_impl<1>;
+template [[host_name("kernel_compat_norm_mul_f32")]]     kernel kernel_compat_norm_fuse_t kernel_compat_norm_fuse_impl<2>;
+template [[host_name("kernel_compat_norm_mul_add_f32")]] kernel kernel_compat_norm_fuse_t kernel_compat_norm_fuse_impl<3>;
+
+template <short F>
+kernel void kernel_compat_rms_norm_fuse_impl(
+        constant ggml_metal_kargs_norm & args,
+        device const char * src0,
+        device const char * src1_0,
+        device const char * src1_1,
+        device       char * dst,
+        device const char * src1_2,
+        device       char * dst_res,
+        threadgroup float * shmem_f32 [[threadgroup(0)]],
+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort3 tpitg[[thread_position_in_threadgroup]],
+        ushort3   ntg[[threads_per_threadgroup]]) {
+    const int i01 = tgpig.x;
+    const int i02 = tgpig.y;
+    const int i03 = tgpig.z;
+
+    device const float * x  = (device const float *) (src0   + i03*args.nbf3[0] + i02*args.nbf2[0] + i01*args.nbf1[0]);
+    device const float * f0 = (device const float *) (src1_0 + (i03%args.nef3[1])*args.nbf3[1] + (i02%args.nef2[1])*args.nbf2[1] + (i01%args.nef1[1])*args.nbf1[1]);
+    device const float * f1 = (device const float *) (src1_1 + (i03%args.nef3[2])*args.nbf3[2] + (i02%args.nef2[2])*args.nbf2[2] + (i01%args.nef1[2])*args.nbf1[2]);
+    device       float * y  = (device       float *) (dst    + i03*args.nb3 + i02*args.nb2 + i01*args.nb1);
+
+    float sumf = 0.0f;
+    for (int i00 = tpitg.x; i00 < args.ne00; i00 += ntg.x) {
+        sumf += x[i00]*x[i00];
+    }
+    const float mean  = compat_tg_sum(sumf, shmem_f32, tpitg.x, ntg.x)/args.ne00;
+    const float scale = 1.0f/sqrt(mean + args.eps);
+
+    for (int i00 = tpitg.x; i00 < args.ne00; i00 += ntg.x) {
+        if (F == 1) {
+            y[i00] = (x[i00]*scale);
+        }
+        if (F == 2) {
+            y[i00] = (x[i00]*scale)*f0[i00];
+        }
+        if (F == 3) {
+            y[i00] = (x[i00]*scale)*f0[i00] + f1[i00];
+        }
+    }
+
+    // F == 5: RMS_NORM + MUL + ADD + RMS_NORM + MUL, with the same steps and rounding; the sum goes to dst_res
+    if (F == 5) {
+        device const float * f2 = (device const float *) (src1_2 + (i03%args.nef3[3])*args.nbf3[3] + (i02%args.nef2[3])*args.nbf2[3] + (i01%args.nef1[3])*args.nbf1[3]);
+        device       float * r  = (device       float *) (dst_res + i03*args.nb3 + i02*args.nb2 + i01*args.nb1);
+
+        sumf = 0.0f;
+        for (int i00 = tpitg.x; i00 < args.ne00; i00 += ntg.x) {
+            const float v = (x[i00]*scale)*f0[i00] + f1[i00];
+            r[i00] = v;
+            sumf += v*v;
+        }
+        const float scale2 = 1.0f/sqrt(compat_tg_sum(sumf, shmem_f32, tpitg.x, ntg.x)/args.ne00 + args.eps);
+
+        for (int i00 = tpitg.x; i00 < args.ne00; i00 += ntg.x) {
+            y[i00] = (r[i00]*scale2)*f2[i00];
+        }
+    }
+}
+
+typedef decltype(kernel_compat_rms_norm_fuse_impl<1>) kernel_compat_rms_norm_fuse_t;
+
+template [[host_name("kernel_compat_rms_norm_f32")]]         kernel kernel_compat_rms_norm_fuse_t kernel_compat_rms_norm_fuse_impl<1>;
+template [[host_name("kernel_compat_rms_norm_mul_f32")]]     kernel kernel_compat_rms_norm_fuse_t kernel_compat_rms_norm_fuse_impl<2>;
+template [[host_name("kernel_compat_rms_norm_mul_add_f32")]] kernel kernel_compat_rms_norm_fuse_t kernel_compat_rms_norm_fuse_impl<3>;
+template [[host_name("kernel_compat_rms_norm_mul_add_norm_mul_f32")]] kernel kernel_compat_rms_norm_fuse_t kernel_compat_rms_norm_fuse_impl<5>;
+
+//
+// SOFT_MAX with optional mask (src1), sinks (src2) and ALiBi, scalar rows
+//
+
+template<typename T>
+kernel void kernel_compat_soft_max(
+        constant ggml_metal_kargs_soft_max & args,
+        device const  char * src0,
+        device const  char * src1,
+        device const  char * src2,
+        device        char * dst,
+        threadgroup  float * buf [[threadgroup(0)]],
+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort3 tpitg[[thread_position_in_threadgroup]],
+        ushort3  tptg[[threads_per_threadgroup]]) {
+    const int32_t i03 = tgpig.z;
+    const int32_t i02 = tgpig.y;
+    const int32_t i01 = tgpig.x;
+
+    const int32_t i13 = i03%args.ne13;
+    const int32_t i12 = i02%args.ne12;
+    const int32_t i11 = i01;
+
+    device const float * psrc0 =                (device const float *) (src0 + i01*args.nb01 + i02*args.nb02 + i03*args.nb03);
+    device const     T * pmask = src1 != src0 ? (device const T *    ) (src1 + i11*args.nb11 + i12*args.nb12 + i13*args.nb13) : nullptr;
+    device const float * psrc2 = src2 != src0 ? (device const float *) (src2)                                                 : nullptr;
+    device       float * pdst  =                (device       float *) (dst  + i01*args.nb1  + i02*args.nb2  + i03*args.nb3);
+
+    float slope = 1.0f;
+
+    // ALiBi
+    if (args.max_bias > 0.0f) {
+        const int32_t h = i02;
+
+        const float base = h < args.n_head_log2 ? args.m0 : args.m1;
+        const int   exp  = h < args.n_head_log2 ? h + 1 : 2*(h - args.n_head_log2) + 1;
+
+        slope = pow(base, exp);
+    }
+
+    float lmax = psrc2 ? psrc2[i02] : -INFINITY;
+    for (int i00 = tpitg.x; i00 < args.ne00; i00 += tptg.x) {
+        lmax = MAX(lmax, psrc0[i00]*args.scale + (pmask ? slope*pmask[i00] : 0.0f));
+    }
+    const float max_val = compat_tg_max(lmax, buf, tpitg.x, tptg.x);
+
+    float lsum = 0.0f;
+    for (int i00 = tpitg.x; i00 < args.ne00; i00 += tptg.x) {
+        const float exp_psrc0 = exp((psrc0[i00]*args.scale + (pmask ? slope*pmask[i00] : 0.0f)) - max_val);
+        lsum += exp_psrc0;
+        pdst[i00] = exp_psrc0;
+    }
+    float sum = compat_tg_sum(lsum, buf, tpitg.x, tptg.x);
+
+    if (psrc2) {
+        sum += exp(psrc2[i02] - max_val);
+    }
+
+    const float inv_sum = 1.0f/sum;
+
+    for (int i00 = tpitg.x; i00 < args.ne00; i00 += tptg.x) {
+        pdst[i00] *= inv_sum;
+    }
+}
+
+typedef decltype(kernel_compat_soft_max<float>) kernel_compat_soft_max_t;
+
+template [[host_name("kernel_compat_soft_max_f16")]] kernel kernel_compat_soft_max_t kernel_compat_soft_max<half>;
+template [[host_name("kernel_compat_soft_max_f32")]] kernel kernel_compat_soft_max_t kernel_compat_soft_max<float>;
