+static void ggml_metal_profile_print(ggml_metal_t ctx) {
+    if (!ctx->profile || ctx->profile_graphs == 0) {
+        return;
+    }
+
+    const double n = ctx->profile_graphs;
+    double gpu = 0.0;
+    for (NSString * key in ctx->profile_time) {
+        gpu += [ctx->profile_time[key] doubleValue];
+    }
+
+    GGML_LOG_INFO("%s: %d single-token graphs, per graph: wall %.2f ms, gpu %.2f ms\n", __func__,
+            ctx->profile_graphs, 1e3*ctx->profile_wall/n, 1e3*gpu/n);
+
+    NSArray * keys = [ctx->profile_time keysSortedByValueUsingComparator:^NSComparisonResult(NSNumber * a, NSNumber * b) {
+        return [b compare:a];
+    }];
+    for (NSString * key in keys) {
+        const double t = [ctx->profile_time[key] doubleValue];
+        const int    c = [ctx->profile_count[key] intValue];
+        GGML_LOG_INFO("%s: %-48s %8.3f ms %5.1f%% %6.0f ops %8.1f us/op\n", __func__, [key UTF8String],
+                1e3*t/n, 100.0*t/gpu, c/n, 1e6*t/c);
+    }
+}
+
+static NSString * ggml_metal_profile_key(const struct ggml_tensor * node) {
+    if (node->op == GGML_OP_MUL_MAT && node->src[0]) {
+        return [NSString stringWithFormat:@"MUL_MAT %s %lldx%lld", ggml_type_name(node->src[0]->type),
+                (long long) node->src[0]->ne[1], (long long) node->src[0]->ne[0]];
+    }
+    return [NSString stringWithFormat:@"%s", ggml_op_desc(node)];
+}
+
+static bool ggml_metal_profile_graph(ggml_metal_t ctx, struct ggml_cgraph * gf) {
+    if (gf->n_nodes == 0 || gf->nodes[gf->n_nodes - 1]->ne[1] != 1) {
+        return false;
+    }
+
+    if (ctx->cmd_buf_last) {
+        [ctx->cmd_buf_last waitUntilCompleted];
+        ctx->cmd_buf_last = nil;
+    }
+
+    id<MTLCommandQueue> queue = ggml_metal_device_get_queue(ctx->dev);
+    const int64_t t_start = ggml_time_us();
+
+    for (int i = 0; i < gf->n_nodes; ++i) {
+        @autoreleasepool {
+            id<MTLCommandBuffer> cmd_buf = [queue commandBuffer];
+
+            // a range of one node also keeps fusion from looking past it
+            ggml_metal_op_t ctx_op = ggml_metal_op_init(ctx->dev, cmd_buf, gf, ctx->finfo, i, i + 1, false, false, 0);
+            const bool empty = ggml_metal_op_n_nodes(ctx_op) == 0;
+            if (!empty) {
+                ggml_metal_op_encode(ctx_op, 0);
+            }
+            ggml_metal_op_free(ctx_op);
+
+            [cmd_buf commit];
+            [cmd_buf waitUntilCompleted];
+
+            if (empty) {
+                continue;
+            }
+
+            if ([cmd_buf status] != MTLCommandBufferStatusCompleted) {
+                GGML_LOG_ERROR("%s: command buffer for node %d failed\n", __func__, i);
+                ctx->has_error = true;
+                return true;
+            }
+
+            NSString * key = ggml_metal_profile_key(gf->nodes[i]);
+            const double t = cmd_buf.GPUEndTime - cmd_buf.GPUStartTime;
+            ctx->profile_time[key]  = @([ctx->profile_time[key] doubleValue] + t);
+            ctx->profile_count[key] = @([ctx->profile_count[key] intValue] + 1);
+        }
+    }
+
+    ctx->profile_wall += (ggml_time_us() - t_start)*1e-6;
+    ctx->profile_graphs++;
+
+    return true;
+}
+
 void ggml_metal_free(ggml_metal_t ctx) {
     GGML_LOG_INFO("%s: deallocating\n", __func__);
 
+    ggml_metal_profile_print(ctx);
+    [ctx->profile_time release];
+    [ctx->profile_count release];
+
     for (int i = 0; i < GGML_METAL_MAX_COMMAND_BUFFERS; ++i) {
         if (ctx->cmd_bufs[i].obj) {
             [ctx->cmd_bufs[i].obj release];
@@ -481,6 +582,10 @@ enum ggml_status ggml_metal_graph_compute(ggml_metal_t ctx, struct ggml_cgraph *
         return GGML_STATUS_SUCCESS;
     }
 
+    if (ctx->profile && ggml_metal_profile_graph(ctx, gf)) {
+        return ctx->has_error ? GGML_STATUS_FAILED : GGML_STATUS_SUCCESS;
+    }
+
     // number of nodes encoded by the main thread (empirically determined)
     const int n_main = MAX(64, 0.1*gf->n_nodes);
 
