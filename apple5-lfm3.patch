diff --git a/ggml/src/ggml-metal/kernels/compat.metal b/ggml/src/ggml-metal/kernels/compat.metal
new file mode 100644
index 0000000..8bdd52f
--- /dev/null
+++ b/ggml/src/ggml-metal/kernels/compat.metal
@@ -0,0 +1,745 @@
+#include "common.h"
+#include "dequantize.h"
+
+// Kernels for GPUs without SIMD-group reduction, shuffle or matrix instructions
+// (Metal family Apple5, e.g. A12/A12X/A12Z). Reductions go through threadgroup memory.
+// The host selects these when has_simdgroup_reduction is false.
+
+// largest power of two below ntg (the first step of the tree reductions; larger steps do no work)
+static inline ushort compat_tg_half(ushort ntg) {
+    ushort s = 1;
+    while (2*s < ntg) {
+        s *= 2;
+    }
+    return ntg > 1 ? s : 0;
+}
+
+// Sum of v over all ntg threads of the threadgroup. shmem must hold ntg floats (ntg <= 1024).
+static inline float compat_tg_sum(float v, threadgroup float * shmem, ushort tid, ushort ntg) {
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    shmem[tid] = v;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (ushort s = compat_tg_half(ntg); s > 0; s >>= 1) {
+        if (tid < s && tid + s < ntg) {
+            shmem[tid] += shmem[tid + s];
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    return shmem[0];
+}
+
+static inline float compat_tg_max(float v, threadgroup float * shmem, ushort tid, ushort ntg) {
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    shmem[tid] = v;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (ushort s = compat_tg_half(ntg); s > 0; s >>= 1) {
+        if (tid < s && tid + s < ntg) {
+            shmem[tid] = max(shmem[tid], shmem[tid + s]);
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    return shmem[0];
+}
+
+//
+// MUL_MAT, many src1 rows: dst[r1][r0] = sum_k src0[r0][k] * src1[r1][k]
+//
+// 256 threads compute a 64 (src0 rows) x 64 (src1 rows) tile, 4x4 outputs per thread.
+// Each step stages 32 k values of both operands as half in threadgroup memory, k-major,
+// so a thread reads half4 vectors and does 16 FMAs per pair of loads.
+// Requires ne00 % 32 == 0; src1 rows contiguous; dst contiguous.
+
+#define COMPAT_MM_NR0 64
+#define COMPAT_MM_NR1 64
+#define COMPAT_MM_NK  32
+#define COMPAT_MM_SA  (COMPAT_MM_NR0 + 4)
+#define COMPAT_MM_SB  (COMPAT_MM_NR1 + 4)
+
+template<typename block_q, short nl, void (*dequantize_func)(device const block_q *, short, thread half4x4 &)>
+kernel void kernel_compat_mul_mm(
+        constant ggml_metal_kargs_mul_mm & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        threadgroup  char * shmem [[threadgroup(0)]],
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiitg[[thread_index_in_threadgroup]]) {
+    threadgroup half * sa = (threadgroup half *) shmem;
+    threadgroup half * sb = (threadgroup half *) shmem + COMPAT_MM_NK*COMPAT_MM_SA;
+
+    const int im = tgpig.z;
+    const int r0 = tgpig.y*COMPAT_MM_NR0;
+    const int r1 = tgpig.x*COMPAT_MM_NR1;
+
+    const int i12 = im % args.ne12;
+    const int i13 = im / args.ne12;
+
+    const uint64_t offset0 = (i12/args.r2)*args.nb02 + (i13/args.r3)*args.nb03;
+
+    // compute role: 4 src0 rows x 4 src1 rows
+    const short tr = tiitg / 16;
+    const short tc = tiitg % 16;
+
+    // load role for src0: threads 0..127 dequantize one 16-value chunk each (64 rows x 2 chunks)
+    const short lr0 = tiitg / 2;
+    const short lc0 = tiitg % 2;
+
+    // load role for src1: 64 rows x 32 values, 8 values per thread
+    const short lr1 = tiitg / 4;
+    const short lk1 = (tiitg % 4) * 8;
+
+    // rows past the matrix edge load a valid row; their results are not stored
+    const int row0 = min(r0 + lr0, args.ne0 - 1);
+    const int row1 = min(r1 + lr1, args.ne1 - 1);
+
+    device const block_q * x = (device const block_q *) (src0 + args.nb01*row0 + offset0);
+    device const float   * y = (device const float   *) (src1 + args.nb13*i13 + args.nb12*i12 + args.nb11*row1);
+
+    float4 acc[4] = { float4(0.0f), float4(0.0f), float4(0.0f), float4(0.0f) };
+
+    for (int k0 = 0; k0 < args.ne00; k0 += COMPAT_MM_NK) {
+        if (tiitg < 128) {
+            const int chunk = k0/16 + lc0;
+            half4x4 v;
+            dequantize_func(x + chunk/nl, chunk%nl, v);
+            for (short i = 0; i < 16; ++i) {
+                sa[(lc0*16 + i)*COMPAT_MM_SA + lr0] = v[i/4][i%4];
+            }
+        }
+
+        for (short i = 0; i < 8; ++i) {
+            sb[(lk1 + i)*COMPAT_MM_SB + lr1] = (half) y[k0 + lk1 + i];
+        }
+
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+
+        for (short k = 0; k < COMPAT_MM_NK; ++k) {
+            const float4 b = float4(*(threadgroup const half4 *) (sb + k*COMPAT_MM_SB + tc*4));
+            const half4  a =        *(threadgroup const half4 *) (sa + k*COMPAT_MM_SA + tr*4);
+
+            acc[0] += b*float(a.x);
+            acc[1] += b*float(a.y);
+            acc[2] += b*float(a.z);
+            acc[3] += b*float(a.w);
+        }
+
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+
+    device float * d = (device float *) dst + im*args.ne1*args.ne0;
+
+    for (short i = 0; i < 4; ++i) {
+        const int i0 = r0 + tr*4 + i;
+        if (i0 >= args.ne0) {
+            break;
+        }
+        for (short j = 0; j < 4; ++j) {
+            const int i1 = r1 + tc*4 + j;
+            if (i1 < args.ne1) {
+                d[i1*args.ne0 + i0] = acc[i][j];
+            }
+        }
+    }
+}
+
+typedef decltype(kernel_compat_mul_mm<half4x4, 1, dequantize_f16>) compat_mul_mm_t;
+
+template [[host_name("kernel_compat_mul_mm_f32_f32")]]  kernel compat_mul_mm_t kernel_compat_mul_mm<float4x4,   1,     dequantize_f32>;
+template [[host_name("kernel_compat_mul_mm_f16_f32")]]  kernel compat_mul_mm_t kernel_compat_mul_mm<half4x4,    1,     dequantize_f16>;
+template [[host_name("kernel_compat_mul_mm_q1_0_f32")]] kernel compat_mul_mm_t kernel_compat_mul_mm<block_q1_0, 8,     dequantize_q1_0>;
+template [[host_name("kernel_compat_mul_mm_q4_0_f32")]] kernel compat_mul_mm_t kernel_compat_mul_mm<block_q4_0, 2,     dequantize_q4_0>;
+template [[host_name("kernel_compat_mul_mm_q4_1_f32")]] kernel compat_mul_mm_t kernel_compat_mul_mm<block_q4_1, 2,     dequantize_q4_1>;
+template [[host_name("kernel_compat_mul_mm_q5_0_f32")]] kernel compat_mul_mm_t kernel_compat_mul_mm<block_q5_0, 2,     dequantize_q5_0>;
+template [[host_name("kernel_compat_mul_mm_q5_1_f32")]] kernel compat_mul_mm_t kernel_compat_mul_mm<block_q5_1, 2,     dequantize_q5_1>;
+template [[host_name("kernel_compat_mul_mm_q8_0_f32")]] kernel compat_mul_mm_t kernel_compat_mul_mm<block_q8_0, 2,     dequantize_q8_0>;
+template [[host_name("kernel_compat_mul_mm_q2_K_f32")]] kernel compat_mul_mm_t kernel_compat_mul_mm<block_q2_K, QK_NL, dequantize_q2_K>;
+template [[host_name("kernel_compat_mul_mm_q3_K_f32")]] kernel compat_mul_mm_t kernel_compat_mul_mm<block_q3_K, QK_NL, dequantize_q3_K>;
+template [[host_name("kernel_compat_mul_mm_q4_K_f32")]] kernel compat_mul_mm_t kernel_compat_mul_mm<block_q4_K, QK_NL, dequantize_q4_K>;
+template [[host_name("kernel_compat_mul_mm_q5_K_f32")]] kernel compat_mul_mm_t kernel_compat_mul_mm<block_q5_K, QK_NL, dequantize_q5_K>;
+template [[host_name("kernel_compat_mul_mm_q6_K_f32")]] kernel compat_mul_mm_t kernel_compat_mul_mm<block_q6_K, QK_NL, dequantize_q6_K>;
+template [[host_name("kernel_compat_mul_mm_iq4_nl_f32")]] kernel compat_mul_mm_t kernel_compat_mul_mm<block_iq4_nl, 2,     dequantize_iq4_nl>;
+template [[host_name("kernel_compat_mul_mm_iq4_xs_f32")]] kernel compat_mul_mm_t kernel_compat_mul_mm<block_iq4_xs, QK_NL, dequantize_iq4_xs>;
+
+//
+// MUL_MAT, few src1 rows: one dot product per (src0 row, src1 row)
+//
+// COMPAT_MV_NL threads share a src0 row and take every COMPAT_MV_NL-th 16-value chunk;
+// 2 lanes per row was the fastest layout measured on the A12Z.
+// Requires ne00 % 16 == 0; src1 rows contiguous; dst contiguous.
+
+#define COMPAT_MV_NL 2
+
+template<typename block_q, short nl, void (*dequantize_func)(device const block_q *, short, thread float4x4 &)>
+kernel void kernel_compat_mul_mv(
+        constant ggml_metal_kargs_mul_mv & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        threadgroup  char * shmem [[threadgroup(0)]],
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiitg[[thread_index_in_threadgroup]],
+        ushort3 ntg [[threads_per_threadgroup]]) {
+    threadgroup float * sum_buf = (threadgroup float *) shmem;
+
+    const short lane = tiitg % COMPAT_MV_NL;
+    const int   r0   = tgpig.x*(ntg.x/COMPAT_MV_NL) + tiitg/COMPAT_MV_NL;
+    const int   r1   = tgpig.y;
+    const int   im   = tgpig.z;
+
+    const int i12 = im % args.ne12;
+    const int i13 = im / args.ne12;
+
+    const uint64_t offset0 = (i12/args.r2)*args.nb02 + (i13/args.r3)*args.nb03;
+
+    float sum = 0.0f;
+
+    if (r0 < args.ne01) {
+        device const block_q * x = (device const block_q *) (src0 + args.nb01*r0 + offset0);
+        device const float   * y = (device const float   *) (src1 + args.nb13*i13 + args.nb12*i12 + args.nb11*r1);
+
+        const int nchunks = args.ne00/16;
+
+        for (int c = lane; c < nchunks; c += COMPAT_MV_NL) {
+            float4x4 w;
+            dequantize_func(x + c/nl, c%nl, w);
+
+            device const float * yc = y + 16*c;
+            for (short i = 0; i < 4; ++i) {
+                sum += dot(w[i], float4(yc[4*i + 0], yc[4*i + 1], yc[4*i + 2], yc[4*i + 3]));
+            }
+        }
+    }
+
+    sum_buf[tiitg] = sum;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    if (lane == 0 && r0 < args.ne01) {
+        for (short i = 1; i < COMPAT_MV_NL; ++i) {
+            sum += sum_buf[tiitg + i];
+        }
+        device float * d = (device float *) dst + im*args.ne1*args.ne0;
+        d[r1*args.ne0 + r0] = sum;
+    }
+}
+
+typedef decltype(kernel_compat_mul_mv<half4x4, 1, dequantize_f16>) compat_mul_mv_t;
+
+template [[host_name("kernel_compat_mul_mv_f32_f32")]]  kernel compat_mul_mv_t kernel_compat_mul_mv<float4x4,   1,     dequantize_f32>;
+template [[host_name("kernel_compat_mul_mv_f16_f32")]]  kernel compat_mul_mv_t kernel_compat_mul_mv<half4x4,    1,     dequantize_f16>;
+template [[host_name("kernel_compat_mul_mv_q1_0_f32")]] kernel compat_mul_mv_t kernel_compat_mul_mv<block_q1_0, 8,     dequantize_q1_0>;
+template [[host_name("kernel_compat_mul_mv_q4_1_f32")]] kernel compat_mul_mv_t kernel_compat_mul_mv<block_q4_1, 2,     dequantize_q4_1>;
+template [[host_name("kernel_compat_mul_mv_q5_0_f32")]] kernel compat_mul_mv_t kernel_compat_mul_mv<block_q5_0, 2,     dequantize_q5_0>;
+template [[host_name("kernel_compat_mul_mv_q5_1_f32")]] kernel compat_mul_mv_t kernel_compat_mul_mv<block_q5_1, 2,     dequantize_q5_1>;
+template [[host_name("kernel_compat_mul_mv_q8_0_f32")]] kernel compat_mul_mv_t kernel_compat_mul_mv<block_q8_0, 2,     dequantize_q8_0>;
+template [[host_name("kernel_compat_mul_mv_q2_K_f32")]] kernel compat_mul_mv_t kernel_compat_mul_mv<block_q2_K, QK_NL, dequantize_q2_K>;
+template [[host_name("kernel_compat_mul_mv_q3_K_f32")]] kernel compat_mul_mv_t kernel_compat_mul_mv<block_q3_K, QK_NL, dequantize_q3_K>;
+template [[host_name("kernel_compat_mul_mv_q4_K_f32")]] kernel compat_mul_mv_t kernel_compat_mul_mv<block_q4_K, QK_NL, dequantize_q4_K>;
+template [[host_name("kernel_compat_mul_mv_q5_K_f32")]] kernel compat_mul_mv_t kernel_compat_mul_mv<block_q5_K, QK_NL, dequantize_q5_K>;
+template [[host_name("kernel_compat_mul_mv_q6_K_f32")]] kernel compat_mul_mv_t kernel_compat_mul_mv<block_q6_K, QK_NL, dequantize_q6_K>;
+template [[host_name("kernel_compat_mul_mv_iq4_nl_f32")]] kernel compat_mul_mv_t kernel_compat_mul_mv<block_iq4_nl, 2,     dequantize_iq4_nl>;
+template [[host_name("kernel_compat_mul_mv_iq4_xs_f32")]] kernel compat_mul_mv_t kernel_compat_mul_mv<block_iq4_xs, QK_NL, dequantize_iq4_xs>;
+
+//
+// F16 matrix-vector with one src1 column broadcast over R2 src1 matrices (attention with grouped-query heads):
+// the R2 query heads of a key/value head share src0. A thread loads each src0 chunk once and uses it for all R2
+// src1 matrices, so K is read once instead of R2 times. COMPAT_MV_NL (2) threads share a src0 row.
+// Used for K times Q (short rows, many rows): on the A12Z at 8192 cached tokens it takes 0.23 ms per layer against
+// 0.44 ms. For V^T times the attention weights (long rows, few rows) the plain kernel is faster (0.33 against 0.36
+// ms), also with 8 or 32 threads per row.
+// Requires ne00 % 4 == 0, contiguous src0 and src1 rows, ne03 == ne13 == 1.
+//
+
+template<short R2>
+kernel void kernel_compat_mul_mv_f16_f32_gqa(
+        constant ggml_metal_kargs_mul_mv & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        threadgroup  char * shmem [[threadgroup(0)]],
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiitg[[thread_index_in_threadgroup]],
+        ushort3 ntg [[threads_per_threadgroup]]) {
+    threadgroup float * sum_buf = (threadgroup float *) shmem;
+
+    const short lane = tiitg % COMPAT_MV_NL;
+    const int   r0   = tgpig.x*(ntg.x/COMPAT_MV_NL) + tiitg/COMPAT_MV_NL;
+    const int   r1   = tgpig.y;
+    const int   h    = tgpig.z;
+
+    float sum[R2];
+    for (short j = 0; j < R2; ++j) {
+        sum[j] = 0.0f;
+    }
+
+    if (r0 < args.ne01) {
+        device const half4 * x = (device const half4 *) (src0 + args.nb01*r0 + args.nb02*h);
+        device const float4 * y[R2];
+        for (short j = 0; j < R2; ++j) {
+            y[j] = (device const float4 *) (src1 + args.nb12*(h*R2 + j) + args.nb11*r1);
+        }
+
+        const int nc = args.ne00/4;
+        for (int c = lane; c < nc; c += COMPAT_MV_NL) {
+            const float4 w = float4(x[c]);
+            for (short j = 0; j < R2; ++j) {
+                sum[j] += dot(w, y[j][c]);
+            }
+        }
+    }
+
+    for (short j = 0; j < R2; ++j) {
+        sum_buf[tiitg*R2 + j] = sum[j];
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    if (lane == 0 && r0 < args.ne01) {
+        device float * d = (device float *) dst;
+        for (short j = 0; j < R2; ++j) {
+            float v = sum[j];
+            for (short i = 1; i < COMPAT_MV_NL; ++i) {
+                v += sum_buf[(tiitg + i)*R2 + j];
+            }
+            d[(h*R2 + j)*args.ne1*args.ne0 + r1*args.ne0 + r0] = v;
+        }
+    }
+}
+
+typedef decltype(kernel_compat_mul_mv_f16_f32_gqa<2>) compat_mul_mv_gqa_t;
+
+template [[host_name("kernel_compat_mul_mv_f16_f32_gqa2")]] kernel compat_mul_mv_gqa_t kernel_compat_mul_mv_f16_f32_gqa<2>;
+template [[host_name("kernel_compat_mul_mv_f16_f32_gqa4")]] kernel compat_mul_mv_gqa_t kernel_compat_mul_mv_f16_f32_gqa<4>;
+template [[host_name("kernel_compat_mul_mv_f16_f32_gqa8")]] kernel compat_mul_mv_gqa_t kernel_compat_mul_mv_f16_f32_gqa<8>;
+
+//
+// Q4_0 times NY src1 columns (1 <= ne11 <= 8: generation, and speculative-decoding verification).
+// A thread works on R rows and on a quarter of a block at a time: bytes qs[4s..4s+3], which hold
+// the values 4s..4s+3 (low nibbles) and 16+4s..16+4s+3 (high nibbles). It loads the matching src1
+// values of all columns once and uses them for all R rows, so src1 loads are 1/R of a per-row
+// kernel. The low and high halves run one after the other, to keep fewer values in registers.
+// src1 and the dot products stay float. With half dot products, speculative decoding no longer
+// gave the same tokens as plain greedy decoding (a model with activations up to about 1200).
+// Float costs about 7% of the verification speed on the A12Z.
+// COMPAT_MV_NY_NL threads share the rows and walk the quarters.
+// Rows per threadgroup: nth/COMPAT_MV_NY_NL*R. Threadgroup memory: nth*R*NY floats for the sums.
+// For one column (LFM3-1.7B on the A12Z, 2026-10-29) this layout generated 31.6 tok/s, against 29.3 for a
+// kernel with 2 threads per row and whole blocks; 2 or 8 rows, or 8 or 32 lanes, were slower.
+//
+
+#define COMPAT_MV_NY_NL 16
+
+#define COMPAT_MUL_MV_Q4_0_NY(name, NY, R)                                                             \
+kernel void name(                                                                                      \
+        constant ggml_metal_kargs_mul_mv & args,                                                       \
+        device const char * src0,                                                                      \
+        device const char * src1,                                                                      \
+        device       char * dst,                                                                       \
+        threadgroup  char * shmem [[threadgroup(0)]],                                                  \
+        uint3  tgpig[[threadgroup_position_in_grid]],                                                  \
+        ushort tiitg[[thread_index_in_threadgroup]],                                                   \
+        ushort3 ntg [[threads_per_threadgroup]]) {                                                     \
+    threadgroup float * sum_buf = (threadgroup float *) shmem;                                         \
+                                                                                                       \
+    const short lane = tiitg % COMPAT_MV_NY_NL;                                                        \
+    const int   r0   = (tgpig.x*(ntg.x/COMPAT_MV_NY_NL) + tiitg/COMPAT_MV_NY_NL)*(R);                  \
+    const int   r1b  = tgpig.y*(NY);                                                                   \
+    const int   im   = tgpig.z;                                                                        \
+                                                                                                       \
+    const int i12 = im % args.ne12;                                                                    \
+    const int i13 = im / args.ne12;                                                                    \
+                                                                                                       \
+    const uint64_t offset0 = (i12/args.r2)*args.nb02 + (i13/args.r3)*args.nb03;                        \
+    const short ncols = min((NY), args.ne11 - r1b);                                                    \
+                                                                                                       \
+    device const char * x[R];                                                                          \
+    for (short r = 0; r < (R); ++r) {                                                                  \
+        x[r] = src0 + args.nb01*min(r0 + r, args.ne01 - 1) + offset0;                                  \
+    }                                                                                                  \
+    device const char * y[NY];                                                                         \
+    for (short j = 0; j < (NY); ++j) {                                                                 \
+        y[j] = src1 + args.nb13*i13 + args.nb12*i12 + args.nb11*(r1b + min(j, short(ncols - 1)));      \
+    }                                                                                                  \
+                                                                                                       \
+    float sum[R][NY];                                                                                  \
+    for (short r = 0; r < (R); ++r) {                                                                  \
+        for (short j = 0; j < (NY); ++j) {                                                             \
+            sum[r][j] = 0.0f;                                                                          \
+        }                                                                                              \
+    }                                                                                                  \
+                                                                                                       \
+    const int nq = (args.ne00/32)*4;                                                                   \
+                                                                                                       \
+    for (int q = lane; q < nq; q += COMPAT_MV_NY_NL) {                                                 \
+        const int   ib = q/4;                                                                          \
+        const short s  = q%4;                                                                          \
+                                                                                                       \
+        float d[R];                                                                                    \
+        uint  u[R];                                                                                    \
+        for (short r = 0; r < (R); ++r) {                                                              \
+            device const ushort * p = (device const ushort *) (x[r] + ib*18);                          \
+            d[r] = half_scale(*(device const half *) p);                                                     \
+            u[r] = p[1 + 2*s] | (uint(p[2 + 2*s]) << 16);                                              \
+        }                                                                                              \
+                                                                                                       \
+        for (short h = 0; h < 2; ++h) {                                                                \
+            float4 yv[NY];                                                                             \
+            for (short j = 0; j < (NY); ++j) {                                                         \
+                yv[j] = ((device const float4 *) y[j])[ib*8 + 4*h + s];                                \
+            }                                                                                          \
+            for (short r = 0; r < (R); ++r) {                                                          \
+                const uint v = u[r] >> (4*h);                                                          \
+                const float4 w = float4(ushort4(v & 0xF, (v >> 8) & 0xF, (v >> 16) & 0xF, (v >> 24) & 0xF)) - 8.0f; \
+                for (short j = 0; j < (NY); ++j) {                                                     \
+                    sum[r][j] += d[r]*dot(w, yv[j]);                                                   \
+                }                                                                                      \
+            }                                                                                          \
+        }                                                                                              \
+    }                                                                                                  \
+                                                                                                       \
+    for (short r = 0; r < (R); ++r) {                                                                  \
+        for (short j = 0; j < (NY); ++j) {                                                             \
+            sum_buf[(tiitg*(R) + r)*(NY) + j] = sum[r][j];                                             \
+        }                                                                                              \
+    }                                                                                                  \
+    threadgroup_barrier(mem_flags::mem_threadgroup);                                                   \
+                                                                                                       \
+    /* the threads of a row group reduce one (row, column) pair each */                                \
+    threadgroup const float * sb = sum_buf + (tiitg - lane)*(R)*(NY);                                  \
+    device float * dd = (device float *) dst + im*args.ne1*args.ne0;                                   \
+    for (short e = lane; e < (R)*(NY); e += COMPAT_MV_NY_NL) {                                         \
+        const short r = e/(NY);                                                                        \
+        const short j = e%(NY);                                                                        \
+        float v = 0.0f;                                                                                \
+        for (short i = 0; i < COMPAT_MV_NY_NL; ++i) {                                                  \
+            v += sb[i*(R)*(NY) + e];                                                                   \
+        }                                                                                              \
+        if (j < ncols && r0 + r < args.ne01) {                                                         \
+            dd[(r1b + j)*args.ne0 + r0 + r] = v;                                                       \
+        }                                                                                              \
+    }                                                                                                  \
+}
+
+// rows per thread measured on the A12Z (more rows spill registers);
+// keep them in sync with ggml_metal_op_mul_mat_compat
+COMPAT_MUL_MV_Q4_0_NY(kernel_compat_mul_mv_q4_0_f32_ny1, 1, 4)
+COMPAT_MUL_MV_Q4_0_NY(kernel_compat_mul_mv_q4_0_f32_ny2, 2, 4)
+COMPAT_MUL_MV_Q4_0_NY(kernel_compat_mul_mv_q4_0_f32_ny4, 4, 4)
+COMPAT_MUL_MV_Q4_0_NY(kernel_compat_mul_mv_q4_0_f32_ny8, 8, 2)
+
+//
+// Q1_0 times one src1 column (generation), for the 1-bit output sketch of LFM3.
+// sign(w) . y = 2*(sum of y where the bit is set) - (sum of y). Each threadgroup first quantizes y to 8 bits per
+// 32-value chunk (scale max|y|/127) and stores the 8 bit planes of q + 128. The sum of q over the set bits of a chunk
+// is then sum_p 2^p popcount(bits & plane_p) - 128 popcount(bits): integer work, with the planes shared by all rows.
+// The generic kernel spent about 2.4 ms on the 128000 x 2048 sketch on the A12Z, as it did 16 selects per 16 values.
+// Lanes and rows as in the Q4_0 kernel: COMPAT_MV_NY_NL lanes walk the 32-value chunks of COMPAT_Q1_0_R rows.
+// The threadgroups loop over the row blocks, so a threadgroup builds the planes once.
+// Threadgroup memory: (ne00/32)*10 + nth*COMPAT_Q1_0_R floats.
+//
+
+#define COMPAT_Q1_0_R 4
+
+kernel void kernel_compat_mul_mv_q1_0_f32_ny1(
+        constant ggml_metal_kargs_mul_mv & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        threadgroup  char * shmem [[threadgroup(0)]],
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        uint3  ntgs [[threadgroups_per_grid]],
+        ushort tiitg[[thread_index_in_threadgroup]],
+        ushort3 ntg [[threads_per_threadgroup]]) {
+    const int nc = args.ne00/32;
+
+    threadgroup uint  * planes  = (threadgroup uint  *) shmem;          // [nc][8]
+    threadgroup float * cscale  = (threadgroup float *) (planes + 8*nc); // [nc]
+    threadgroup int   * cqsum   = (threadgroup int   *) (cscale + nc);   // [nc] sum of q
+    threadgroup float * sum_buf = (threadgroup float *) (cqsum + nc);    // [nth][R]
+
+    const int r1 = tgpig.y;
+    const int im = tgpig.z;
+
+    const int i12 = im % args.ne12;
+    const int i13 = im / args.ne12;
+
+    const uint64_t offset0 = (i12/args.r2)*args.nb02 + (i13/args.r3)*args.nb03;
+
+    device const float * y = (device const float *) (src1 + args.nb13*i13 + args.nb12*i12 + args.nb11*r1);
+
+    for (int c = tiitg; c < nc; c += ntg.x) {
+        device const float4 * yc = (device const float4 *) (y + 32*c);
+        float4 v[8];
+        float amax = 0.0f;
+        for (short i = 0; i < 8; ++i) {
+            v[i] = yc[i];
+            const float4 a = abs(v[i]);
+            amax = max(amax, max(max(a.x, a.y), max(a.z, a.w)));
+        }
+        const float sc = amax/127.0f;
+        const float is = amax > 0.0f ? 127.0f/amax : 0.0f;
+        uint p[8] = { 0, 0, 0, 0, 0, 0, 0, 0 };
+        int qsum = 0;
+        for (short i = 0; i < 8; ++i) {
+            for (short k = 0; k < 4; ++k) {
+                const int  q = int(rint(v[i][k]*is));
+                const uint u = uint(q + 128);
+                qsum += q;
+                for (short b = 0; b < 8; ++b) {
+                    p[b] |= ((u >> b) & 1u) << (4*i + k);
+                }
+            }
+        }
+        for (short b = 0; b < 8; ++b) {
+            planes[8*c + b] = p[b];
+        }
+        cscale[c] = sc;
+        cqsum[c]  = qsum;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    const short lane = tiitg % COMPAT_MV_NY_NL;
+    const int   nrb  = (ntg.x/COMPAT_MV_NY_NL)*COMPAT_Q1_0_R; // rows per block
+    device float * dd = (device float *) dst + im*args.ne1*args.ne0 + r1*args.ne0;
+
+    for (int rb = tgpig.x; rb*nrb < args.ne01; rb += ntgs.x) {
+        const int r0 = rb*nrb + (tiitg/COMPAT_MV_NY_NL)*COMPAT_Q1_0_R;
+
+        device const char * x[COMPAT_Q1_0_R];
+        float sum[COMPAT_Q1_0_R];
+        for (short r = 0; r < COMPAT_Q1_0_R; ++r) {
+            x[r]   = src0 + args.nb01*min(r0 + r, args.ne01 - 1) + offset0;
+            sum[r] = 0.0f;
+        }
+
+        for (int c = lane; c < nc; c += COMPAT_MV_NY_NL) {
+            const int   ib = c/4;
+            const short s  = c%4;
+
+            uint pl[8];
+            for (short b = 0; b < 8; ++b) {
+                pl[b] = planes[8*c + b];
+            }
+            const float sc = cscale[c];
+            const int   qs = cqsum[c];
+
+            for (short r = 0; r < COMPAT_Q1_0_R; ++r) {
+                device const ushort * p = (device const ushort *) (x[r] + ib*18);
+                const float d    = half_scale(*(device const half *) p);
+                const uint  bits = p[1 + 2*s] | (uint(p[2 + 2*s]) << 16);
+                int acc = -128*int(popcount(bits));
+                for (short b = 0; b < 8; ++b) {
+                    acc += int(popcount(bits & pl[b])) << b;
+                }
+                sum[r] += d*sc*float(2*acc - qs);
+            }
+        }
+
+        for (short r = 0; r < COMPAT_Q1_0_R; ++r) {
+            sum_buf[tiitg*COMPAT_Q1_0_R + r] = sum[r];
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+
+        if (lane < COMPAT_Q1_0_R && r0 + lane < args.ne01) {
+            threadgroup const float * sb = sum_buf + (tiitg - lane)*COMPAT_Q1_0_R + lane;
+            float v = 0.0f;
+            for (short i = 0; i < COMPAT_MV_NY_NL; ++i) {
+                v += sb[i*COMPAT_Q1_0_R];
+            }
+            dd[r0 + lane] = v;
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+}
+
+//
+// NORM / RMS_NORM with optional fused MUL and ADD (F = 1, 2, 3), scalar float rows
+//
+
+template <short F>
+kernel void kernel_compat_norm_fuse_impl(
+        constant ggml_metal_kargs_norm & args,
+        device const char * src0,
+        device const char * src1_0,
+        device const char * src1_1,
+        device       char * dst,
+        threadgroup float * shmem_f32 [[threadgroup(0)]],
+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort3 tpitg[[thread_position_in_threadgroup]],
+        ushort3   ntg[[threads_per_threadgroup]]) {
+    const int i01 = tgpig.x;
+    const int i02 = tgpig.y;
+    const int i03 = tgpig.z;
+
+    device const float * x  = (device const float *) (src0   + i03*args.nbf3[0] + i02*args.nbf2[0] + i01*args.nbf1[0]);
+    device const float * f0 = (device const float *) (src1_0 + (i03%args.nef3[1])*args.nbf3[1] + (i02%args.nef2[1])*args.nbf2[1] + (i01%args.nef1[1])*args.nbf1[1]);
+    device const float * f1 = (device const float *) (src1_1 + (i03%args.nef3[2])*args.nbf3[2] + (i02%args.nef2[2])*args.nbf2[2] + (i01%args.nef1[2])*args.nbf1[2]);
+    device       float * y  = (device       float *) (dst    + i03*args.nb3 + i02*args.nb2 + i01*args.nb1);
+
+    float sumf = 0.0f;
+    for (int i00 = tpitg.x; i00 < args.ne00; i00 += ntg.x) {
+        sumf += x[i00];
+    }
+    const float mean = compat_tg_sum(sumf, shmem_f32, tpitg.x, ntg.x)/args.ne00;
+
+    sumf = 0.0f;
+    for (int i00 = tpitg.x; i00 < args.ne00; i00 += ntg.x) {
+        y[i00] = x[i00] - mean;
+        sumf += y[i00]*y[i00];
+    }
+    const float variance = compat_tg_sum(sumf, shmem_f32, tpitg.x, ntg.x)/args.ne00;
+
+    const float scale = 1.0f/sqrt(variance + args.eps);
+    for (int i00 = tpitg.x; i00 < args.ne00; i00 += ntg.x) {
+        if (F == 1) {
+            y[i00] = (y[i00]*scale);
+        }
+        if (F == 2) {
+            y[i00] = (y[i00]*scale)*f0[i00];
+        }
+        if (F == 3) {
+            y[i00] = (y[i00]*scale)*f0[i00] + f1[i00];
+        }
+    }
+}
