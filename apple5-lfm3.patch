+    char key_type[64];
+    char key_name[GGML_MAX_NAME + 16];
+    snprintf(key_type, sizeof(key_type), ",MUL_MAT:%s,", ggml_type_name(node->src[0]->type));
+    snprintf(key_name, sizeof(key_name), ",MUL_MAT@%s,", node->src[0]->name);
+    if (strstr(list, key_type) || strstr(list, key_name)) {
+        return true;
+    }
+    for (const char * p = strstr(list, ",MUL_MAT~"); p; p = strstr(p + 1, ",MUL_MAT~")) {
+        char part[GGML_MAX_NAME] = "";
+        sscanf(p + 9, "%63[^,]", part);
+        if (part[0] && strstr(node->src[0]->name, part)) {
+            return true;
+        }
+    }
+    return false;
