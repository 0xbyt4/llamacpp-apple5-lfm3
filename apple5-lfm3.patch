 #define QK_NL 16 // shared by mul_mm and get_rows_q instantiations
 
+// A half block scale as float. The Apple5 GPUs (A12) flush a subnormal half to zero, also after a bit cast.
+// Small weights, for example token embeddings in q6_K, have such scales. Convert the bits with integer and
+// float operations only. Scales are finite, so the infinity and NaN encodings are not handled.
+static inline float half_scale(device const half & x) {
+    const uint h = *(device const ushort *) &x;
+    const uint em = h & 0x7FFFu;
+    // a subnormal half is em * 2^-24; a normal half needs the exponent bias 15 -> 127 (112 << 10)
+    const float f = em < 0x0400u ? float(em) * 0x1p-24f : as_type<float>((em + 0x1C000u) << 13);
+    return as_type<float>(as_type<uint>(f) | ((h & 0x8000u) << 16));
+}
